  "flows": [
    {
      "id": "FLOW-FOREGROUND-CACHE",
      "steps": [
        "初始化 Images",
        "读取旧索引 URL",
        "请求默认 n=7 归档",
        "串行逐张命中判断/下载/保存",
        "有实际下载才保存新归档",
        "true 返回后才清理旧图"
      ],
      "source": "docs/network-and-download.md"
    },
    {
      "id": "FLOW-BACKGROUND",
      "steps": [
        "Windows 触发后台 Run",
        "取得 deferral",
        "磁贴提供器",
        "锁屏提供器",
        "桌面提供器",
        "Complete deferral"
      ],
      "qualification": "各提供器有自己的门控和异常处理；不是每次触发都发生三次系统提交。",
      "source": "docs/background-and-personalization.md"
    },
    {
      "id": "FLOW-SETTINGS-MIGRATION",
      "steps": [
        "读取指定 Roaming 值",
        "仅非 null 时覆盖同名 Local 值",
        "Roaming 同名项赋 null"
      ],
      "keys": [
        "UseBingImageAsLockScreen",
        "CurrentLockScreenImageUrl"
      ],
      "source": "docs/data-model-and-storage.md"
    },
    {
      "id": "FLOW-IMAGE-SOURCE",
      "steps": [
        "ImageSource 为 null 时发起异步加载",
        "等待图片服务返回流",
        "创建 BitmapImage",
        "await SetSourceAsync",
        "发布 ImageSource 属性",
        "finally 关闭非空流"
      ],
      "qualification": "这是前台显示路径；控件 Unloaded 只解除 SourceProperty 回调，未见主动清空图片项的 ImageSource。",
      "source": "docs/image-loading-and-lifetime.md"
    },
    {
      "id": "FLOW-SUSPENDING",
      "steps": [
        "App 构造注册 Suspending",
        "处理器读取 SuspendingOperation",
        "GetDeferral",
        "立即 Complete"
      ],
      "qualification": "完整已解正常路径没有保存状态、等待下载、Stop 或 Dispose；托管 EH 表未完整解析。未建立其他生命周期事件的应用订阅链。",
      "source": "docs/suspend-and-resume.md"
    },
    {
      "id": "FLOW-EXPLICIT-MAINVM-DISPOSE",
      "steps": [
        "进入主 VM Dispose",
        "Stop 小时计时器",
        "Stop 通知计时器",
        "GC.SuppressFinalize(this)"
      ],
      "qualification": "清理入口存在；页面退出/挂起自动调用它的链尚未建立。没有 Tick 退订、清字段或取消在途异步操作。",
      "source": "docs/timers-and-disposal.md"
    }
  ],
