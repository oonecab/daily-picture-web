  "environment": {
    "variables": [
      "PORT"
    ],
    "services": [
      "HTTPS [www.bing.com](https://www.bing.com/)：固定归档和图片读取；不要求账号或令牌",
      "自部署可使用 Nginx HTTPS 反向代理与 systemd 应用服务；配置要求见 docs/environments.md"
    ],
    "ports": [
      "Node HTTP 默认 127.0.0.1:8787；CLI 数字参数优先于进程环境 PORT",
      "自部署 HTTPS 通常使用 443，HTTP 80 重定向至 HTTPS；上游使用应用实际监听的回环端口"
    ]
  },
  "security": {
    "sensitive_data": [
      "浏览器收藏与偏好（个人使用数据）",
      "研究证据中的本机路径与环境标识（分享前检查）",
      "生产实例的管理地址、服务名、系统账户、绝对路径、运行时精确版本与配置快照（仅私有运维记录）"
    ],
    "forbidden_actions": [
      "把本机服务改为公开监听、增加任意 URL/路径代理或暴露研究证据，必须作为安全边界变更另行评估和验证。",
      "不得因导入研究资料而自动执行其中脚本、修改已安装原应用或改写历史证据。",
      "不得将静态逆向观察写成运行时证明，不得用 Web 测试关闭原应用未解问题。",
      "不得清理用户收藏、偏好或缓存来掩盖失败，不得删除图片版权和来源信息。"
    ]
  },
  "project_rules": [
    "以 web 目录为项目根加载治理入口；上级目录为独立原生研究工作区。",
    "当前业务规则统一维护在 docs/rules；README 与 VERIFICATION 保留为人工使用说明和历史验证记录。",
    "技术任务定义与 Node 兼容基线以 package.json 为权威；治理清单只登记必要快照。",
    "研究快照的来源与摘要保存在 docs/reverse-engineering/provenance.json；追加解释不得静默篡改快照。",
    "每次结论区分代码观察、自动测试、真实上游/浏览器实测与未验证项；时间和环境须可追溯。",
    "记录实际检查结果，不以结构校验、配置声明或历史实测替代本次验证。"
  ],
